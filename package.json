{
  "name": "hackerrepos",
  "version": "0.1.0",
  "description": "The GitHub repos Hacker News keeps recommending, ranked by distinct commenters. HackerTube, but for repos.",
  "type": "module",
  "bin": {
    "hackerrepos": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/data/repos.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "data": "node --experimental-strip-types src/cli.ts build",
    "prepack": "npm run build"
  },
  "keywords": [
    "hacker-news",
    "hackernews",
    "github",
    "awesome",
    "recommendations",
    "hackertube",
    "open-source",
    "cli"
  ],
  "author": "Jatin Garg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatingargiitk/hackerrepos.git"
  },
  "homepage": "https://github.com/jatingargiitk/hackerrepos#readme",
  "bugs": {
    "url": "https://github.com/jatingargiitk/hackerrepos/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
